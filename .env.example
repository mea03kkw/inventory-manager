# Environment template for local development.
# Copy this file to .env and adjust values as needed.
# When adding new environment variables, keep the keys in sync between .env.example and .env.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sample_library
APP_ENV=development
SESSION_SECRET=local-dev-secret-not-for-production
ADMIN_PASSWORD=change_this_to_a_strong_local_password
# Optional — Railway production DB URL for clone workflow only (scripts/clone_railway_to_local.py)
# Set this to your Railway PostgreSQL URL when you need to clone production data
# into the local Docker PostgreSQL for testing. Never used by the running app.
# RAILWAY_DATABASE_URL=postgresql://user:pass@host:port/db